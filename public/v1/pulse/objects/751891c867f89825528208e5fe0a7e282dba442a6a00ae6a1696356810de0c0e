        "semver": ">=0.2.0"
      },
      "manifest": {
        "branding": {
          "logo": "local-runtime",
          "hue": 210
        },
        "pitch": "Your own AI, running entirely on your Mac.",
        "description": "One module that unifies what were three separate pages — Local Runtime, Models & Routing, and Usage — as three lenses over the same opta-router endpoints. Watch local inference live, manage which models are resident, and track what your local AI is doing and costing. The three underlying pages are live today; the unified Opta Local module ships with the P2 merge.",
        "audience": [
          "Privacy-minded users who want AI on their own hardware",
          "Anyone running local models on a Mac",
          "Developers tuning local model routing"
        ],
        "useCases": [
          "Chat with models that never leave your machine",
          "See which models are loaded and what they cost in memory",
          "Route requests to the right local model automatically",
          "Track local usage over time"
        ],
        "complexity": "standard",
        "parts": [
          {
            "id": "page",
            "kind": "page",
            "label": "Opta Local page (runtime, models, and usage lenses)",
            "removable": true,
            "keepOnUninstallByDefault": false
          },
          {
            "id": "opta-router",
            "kind": "daemon",
            "label": "Opta Router — local model routing daemon",
            "removable": true,
            "keepOnUninstallByDefault": true
          },
          {
            "id": "inference-engine",
            "kind": "daemon",
            "label": "Local inference engine",
            "sizeEstimate": "models can run to several GB",
            "removable": true,
            "keepOnUninstallByDefault": true
          }
        ],
        "requirements": [
          {
            "id": "opta-router",
            "label": "Opta Router daemon running on this Mac",
            "probe": "daemon-socket",
            "remediation": "wizard"
          }
        ]
      }
